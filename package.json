  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20 <21 || >=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "scripts": {
    "build": "webpack",
    "test": "jest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:e2e:live": "npm run build && playwright test --grep @live --workers=1",
    "auth:bing": "playwright codegen --save-storage=playwright/.auth/bing.json https://www.bing.com"
  },
  "overrides": {
    "babel-plugin-istanbul": "8.0.0",
    "brace-expansion@<1.1.16": "1.1.16",
    "fast-uri@<=3.1.3": "3.1.4",
    "glob": "13.0.6",
    "js-yaml@>=5.0.0 <=5.2.1": "5.2.2",
    "test-exclude": "8.0.0"
  }
}
